{
  "name": "dragapultist-desktop",
  "productName": "Dragapultist Beta",
  "version": "0.3.0-beta.3",
  "private": true,
  "description": "Dragapultist desktop clipboard companion",
  "author": {
    "name": "Christopher Capizzuto"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "verify:focus": "node scripts/verify-focus-dependency.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64 --publish never && node scripts/verify-mac-signature.cjs && node scripts/checksums.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never && node scripts/checksums.cjs",
    "legal:prepare": "node scripts/prepare-legal.cjs"
  },
  "dependencies": {
    "get-windows": "9.3.0"
  },
  "overrides": {
    "get-windows": {
      "tar": "7.5.22",
      "http-cache-semantics": "4.3.0"
    }
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.dragapultist.desktop.beta",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "queue.cjs",
      "transport.cjs",
      "game-focus.cjs",
      "overlay.cjs",
      "overlay-model.cjs",
      "overlay-preload.js",
      "overlay.html",
      "overlay.css",
      "overlay-renderer.js",
      "assets/**/*",
      "offline.html",
      "package.json",
      "startup.cjs",
      "agreement.cjs",
      "agreement-preload.js",
      "agreement-renderer.js",
      "agreement.html",
      "agreement.css",
      "legal/generated/manifest.json"
    ],
    "asar": true,
    "afterPack": "scripts/verify-overlay-package.cjs",
    "afterSign": "scripts/verify-mac-signature.cjs",
    "asarUnpack": [
      "node_modules/get-windows/main",
      "node_modules/get-windows/lib/binding/**/*"
    ],
    "artifactName": "Dragapultist-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "identity": "-",
      "binaries": [
        "Contents/Resources/app.asar.unpacked/node_modules/get-windows/main"
      ],
      "icon": "assets/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "license": "legal/generated/installer-license.txt"
    },
    "publish": null,
    "beforePack": "scripts/prepare-legal.cjs",
    "extraResources": [
      {
        "from": "legal/generated",
        "to": "Legal",
        "filter": [
          "*.txt",
          "*.html"
        ]
      }
    ],
    "dmg": {
      "license": "legal/generated/installer-license.txt"
    }
  },
  "allowScripts": {
    "get-windows@9.3.0": true,
    "electron@44.4.5": true
  }
}
